body { font-family: sans-serif; background: #f0f0f0; padding: 30px; direction: rtl; }
.box { background: #fff; padding: 20px; border-radius: 10px; max-width: 600px; margin: auto; box-shadow: 0 0 10px #ccc; }
.result { margin-top: 15px; padding: 10px; border-radius: 5px; color: white; font-weight: bold; }
.green { background-color: green; }
.orange { background-color: orange; }
.red { background-color: red; }
ul { padding: 0 20px; }
